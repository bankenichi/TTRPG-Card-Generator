<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" href="/icons/favicon.svg" type="image/svg+xml"><title>TTRPG Card Generator</title><style>__SHELL_CSS__
__WORKBENCH_CSS__</style></head><body>
<a class="skip-link" href="#content-panel">Skip to deck controls</a>
<header class="topbar"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">T</span><span><span class="brand-name">TTRPG Card Generator</span><span class="brand-subtitle">A workbench for your next session</span></span></a><nav class="top-actions" aria-label="Application"><span class="badge"><i class="dot"></i>Local workspace</span><a class="setup-link" href="/data-setup">Data setup <span aria-hidden="true">↗</span></a></nav></header>
<div class="workspace">
<aside class="library panel" aria-label="Content categories"><div class="library-heading"><div class="eyebrow">Your content</div><span id="selected-count" class="badge">0 selected</span></div><label class="sr-only" for="category-search">Search categories</label><input id="category-search" type="search" placeholder="Search categories" autocomplete="off"><div id="category-list"></div><p class="library-help help">Choose as many categories as your session needs.</p><button id="reset-deck" class="quiet small-button">Reset deck</button></aside>
<main id="content-panel" class="main-column" tabindex="-1"><div class="workspace-intro"><div class="eyebrow">Deck builder</div><h1>Build your next deck.</h1><p class="muted">Choose your content, then make it yours.</p></div>
<div class="section-tabs" role="tablist" aria-label="Deck configuration"><button id="content-tab" role="tab" aria-selected="true" aria-controls="content-section" class="active">Content</button><button id="appearance-tab" role="tab" aria-selected="false" aria-controls="appearance-section">Appearance</button></div>
<section id="content-section" class="panel editor-panel" role="tabpanel" aria-labelledby="content-tab"><div id="filter-panel"></div></section>
<section id="appearance-section" class="panel editor-panel" role="tabpanel" aria-labelledby="appearance-tab" hidden><div class="editor-heading"><div><div class="eyebrow">Finishing touches</div><h2>Make it yours.</h2></div><button id="reset-appearance" class="quiet small-button">Use defaults</button></div><p class="help">Choose built-in artwork, or upload an SVG for this session.</p><div id="appearance-controls" class="appearance-grid"></div><p class="help appearance-note">Custom SVGs override the matching built-in selection. Uploads are kept for this session.</p></section>
<section id="result-panel" class="panel result-panel" aria-label="Generated deck" hidden><div class="eyebrow">Ready for the table</div><h2 id="result-title">Your deck is ready.</h2><p id="result-detail" class="muted"></p><div id="result-types" class="type-badges"></div><div class="result-actions"><a id="preview-link" class="button-link primary" href="#" target="_blank" rel="noopener">Open deck</a><button id="export-cards" class="quiet">Export PDF</button></div></section>
<section id="backs-panel" class="panel result-panel" aria-label="Generated card backs" hidden><h3>Card backs are ready.</h3><div class="result-actions"><a id="backs-preview-link" class="button-link" href="#" target="_blank" rel="noopener">Open card backs</a><button id="export-backs" class="quiet">Export backs PDF</button></div></section>
<div id="status" class="status" role="status" aria-live="polite">Choose content to begin.</div><section id="export-panel" class="panel export-panel" hidden aria-label="PDF export progress"><div class="export-heading"><strong id="export-heading">Preparing PDF</strong><span id="export-progress-label"></span></div><progress id="export-progress" max="100" aria-label="PDF export"></progress><p id="export-message" class="help"></p><a id="pdf-download" class="button-link primary" hidden download>Save complete PDF</a><button id="pdf-share" hidden class="quiet">Share PDF</button></section>
</main>
<aside class="summary panel" aria-label="Deck summary"><div class="eyebrow">Your deck</div><h2 id="summary-title">A fresh start.</h2><p id="summary-help" class="help">Select content from the library to begin.</p><div id="selection-summary"></div><div class="summary-rule"></div><div class="appearance-summary"><span class="glyph" style="--glyph:url('/icons/items.svg')" aria-hidden="true"></span><div><strong id="appearance-label">Classic parchment</strong><button id="show-appearance" class="text-button">Change appearance <span aria-hidden="true">→</span></button></div></div><div class="summary-rule"></div><button id="generateBtn" class="primary generate-button" disabled>Generate deck <span aria-hidden="true">→</span></button><button id="generateBacksBtn" class="quiet backs-button">Generate card backs</button><p class="help summary-footnote">Card counts appear after generation.</p></aside>
</div><footer class="app-footer"><span>Made for the table.</span><span>Letter paper · 2.5 × 3.5 inch cards</span></footer>
<script>window.WORKBENCH=__BOOTSTRAP__;</script><script>__SCRIPT__</script></body></html>
